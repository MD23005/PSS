<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="12dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvTitlePaso1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Información personal"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nombres -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNombres"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Nombres"
        app:boxBackgroundColor="@color/lila_claro"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="0dp"
        app:boxCornerRadiusBottomEnd="0dp"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="#8F8F8F"
        app:endIconMode="clear_text"
        app:endIconTint="#000000"
        app:layout_constraintTop_toBottomOf="@id/tvTitlePaso1">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNombres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nombre que aparece en su DUI"
        android:textColor="@color/gris_texto"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilNombres" />

    <!-- Apellidos -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilApellidos"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:hint="Apellidos"
        app:boxBackgroundColor="@color/lila_claro"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="0dp"
        app:boxCornerRadiusBottomEnd="0dp"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="#8F8F8F"
        app:endIconMode="clear_text"
        app:endIconTint="#000000"
        app:layout_constraintTop_toBottomOf="@id/tilNombres">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtApellidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Apellidos que aparecen en su DUI"
        android:textColor="@color/gris_texto"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilApellidos" />

    <!-- DUI -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDui"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:hint="DUI: 00000000-0"
        app:boxBackgroundColor="@color/lila_claro"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="0dp"
        app:boxCornerRadiusBottomEnd="0dp"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="#8F8F8F"
        app:endIconMode="clear_text"
        app:endIconTint="#000000"
        app:layout_constraintTop_toBottomOf="@id/tilApellidos">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDui"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Número único de identidad"
        android:textColor="@color/gris_texto"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilDui" />

    <!-- DUI -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPass"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:hint="Contraseña para la cuenta"
        app:boxBackgroundColor="@color/lila_claro"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="0dp"
        app:boxCornerRadiusBottomEnd="0dp"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="#8F8F8F"
        app:endIconMode="clear_text"
        app:endIconTint="#000000"
        app:layout_constraintTop_toBottomOf="@id/tilDui">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Contraseña para acceder a la cuenta en PSS"
        android:textColor="@color/gris_texto"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilPass" />

    <!-- Botón Adjuntar e Imagen Previa -->
    <LinearLayout
        android:id="@+id/layoutDuiUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tilPass">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubirDui"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subir imagen del DUI"
            android:drawableStart="@drawable/upload_icon"
            android:padding="12dp"
            android:background="@drawable/bg_button_upload"/>

        <ImageView
            android:id="@+id/imgDuiPreview"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Vista previa DUI" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSiguientePaso2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:src="@drawable/right_arrow"
        app:backgroundTint="@color/lila_claro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="#000000" />

</androidx.constraintlayout.widget.ConstraintLayout>