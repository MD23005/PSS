<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="24dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvTitlePaso3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Aceptar términos y condiciones"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDescPaso3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Lea detenidamente los documentos que se adjuntan a continuación antes de aceptar y continuar"
        android:textColor="@color/gris_texto"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitlePaso3" />

    <!-- Botón Términos -->
    <LinearLayout
        android:id="@+id/btnTerminos"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_button_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescPaso3">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/att_icon"
            app:tint="@color/morado_texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Términos y condiciones"
            android:textColor="@color/morado_texto"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón Declaración -->
    <LinearLayout
        android:id="@+id/btnDeclaracion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnTerminos">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/att_icon"
            app:tint="@color/morado_texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Declaración de verdad"
            android:textColor="@color/morado_texto"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón Atrás -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAtrasPaso3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:src="@drawable/left_arrow"
        app:backgroundTint="@color/lila_claro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#000000" />

    <!-- Botón Registrar Usuario (Más ancho) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegistrarUsuario"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/lila_claro"
        android:text="Registrar usuario"
        android:textAllCaps="false"
        android:textColor="@color/morado_texto"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/save_icon"
        app:iconGravity="textStart"
        app:iconTint="@color/morado_texto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>